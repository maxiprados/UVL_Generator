namespace eShop

features
    eShop
        mandatory
            Catalogue
                [1..5]
                    Europe {price 30}
                    "North America" {price 30}
                    Asia {price 30}
                    "South America" {price 30}
                    Africa {price 30}
            Security
                alternative
                    Standard {price 50}
                    High {price 100}
        optional
            SEO
            Payment
                alternative
                    "Bank Transfer" {price 10, SEPA true}
                    "Credit Card" {price 20}
            Platform
                [2..3]
                    "Mobile App"
                    Browser {url "www.uvleshop.org"}
                    "Desktop App"

constraints
    "Credit Card" => High
    "Bank Transfer" => !"Mobile App"
    sum(price) < 200